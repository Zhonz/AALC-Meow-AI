{
  "PassPrizeStart": {
    "doc": "狂气通票奖励领取路由器（对齐 AALC V1.6.2 get_prize.py）",
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "PassClickSeason",
      "PassEnterMissions"
    ],
    "timeout": 30000,
    "on_error": [
      "PassTryMailFallback"
    ]
  },
  "PassClickSeason": {
    "doc": "主页点赛季通行证入口（home/season_assets.png）",
