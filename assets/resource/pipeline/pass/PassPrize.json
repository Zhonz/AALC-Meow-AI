    "doc": "官方 get_prize.py 的 last_try 单次兜底：点主页邮件入口(+100y)后退出，不无限重试",
    "recognition": {
      "type": "TemplateMatch",
      "template": "home/mail.png",
      "threshold": 0.72,
      "roi": [
        1043,
        77,
        237,
        95
      ]
    },
    "action": "Click",
    "target_offset": [
      0,
      100,
      0,
      0
    ],
    "post_wait_freezes": 800,
    "timeout": 15000,
    "next": [
      "PassReturnHome"
    ],
    "on_error": [
      "PassReturnHome"
    ]
  },
  "PassDone": {
