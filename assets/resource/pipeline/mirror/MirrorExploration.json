  "MirrorHandleShop": {
    "doc": "镜牢商店（顶部经费栏）——交棒节点：管线到这里算本轮任务成功结束，由 Kotlin 脚本接管买卖/治疗/刷新，跑完再从 MirrorDungeonEntry 续上（见 docs/DEVELOPMENT_EXPERIENCE.md §2.14）。识别值沿用原先卡死兜底的 MirrorCheckShopCoins：roi 只框住经费栏，阈 0.88，避免地图上偶现的金币图标误触",
    "recognition": {
      "type": "TemplateMatch",
      "template": "mirror/shop/shop_coins_assets.png",
      "threshold": 0.88,
      "roi": [
        428,
        81,
        346,
        112
