      "type": "TemplateMatch",
      "template": "home/season.png",
      "threshold": 0.72
    },
    "action": "Click",
    "post_wait_freezes": 800,
    "next": [
      "PassEnterMissions",
      "PassSelectDaily"
    ]
  },
